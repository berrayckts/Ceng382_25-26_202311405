@model PagedResult<OrderEntity>
@{
    ViewData["Title"] = "Admin Orders";
}
<section class="plain-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Admin</p>
            <h1>Orders</h1>
            <p class="soft-copy">@Model.TotalItems orders match the current filters.</p>
        </div>
        <form method="get" class="filter-row">
            <input name="search" value="@Model.Search" placeholder="Search orders" />
            <select name="status">
                <option value="">All</option>
                @foreach (var s in OrderStatus.All)
                {
                    <option value="@s" selected="@(ViewBag.Status == s)">@s</option>
                }
            </select>
            <button>Filter</button>
        </form>
    </div>
    <div class="table-shell"><table><thead><tr><th>#</th><th>Customer</th><th>Caterer</th><th>Status</th><th>Total</th><th>Created</th><th></th></tr></thead><tbody>
    @foreach (var order in Model.Items)
    {
        <tr>
            <td>#@order.Id</td>
            <td>@order.Customer?.DisplayName</td>
            <td>@order.Caterer?.Name</td>
            <td><span class="status-pill @(order.Status == OrderStatus.Completed ? "ok" : "muted")">@order.Status</span></td>
            <td>@order.TotalAmount.ToString("C")</td>
            <td>@order.CreatedUtc.ToLocalTime().ToString("g")</td>
            <td><a asp-controller="Orders" asp-action="Details" asp-route-id="@order.Id">Open</a></td>
        </tr>
    }
    </tbody></table></div>
    @await Html.PartialAsync("_Pager", Model)
</section>

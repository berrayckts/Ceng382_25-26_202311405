@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
    var code = Context.Response.StatusCode;
}

<section class="ce-error-page">
    <div class="ce-error-card">
        <p class="ce-eyebrow">@ProjectBranding.Name</p>
        <h1>@(code == 404 ? "Page not found" : "Something went wrong")</h1>
        <p>We could not complete that request. Please return home or try again in a moment.</p>
        @if (Model.ShowRequestId)
        {
            <p class="text-muted small">Request ID: <code>@Model.RequestId</code></p>
        }
        <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Home</a>
    </div>
</section>

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - @ProjectBranding.Name</title>
    <script type="importmap"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/tokens.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/site.custom.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/Northwind.Mvc.styles.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
</head>
<body class="project-body">
    <header class="ce-navbar">
        <nav class="navbar navbar-expand-lg">
            <div class="container-fluid px-4">
            <a class="ce-logo navbar-brand" asp-area="" asp-controller="Home" asp-action="Index">
                <span class="ce-logo-mark">V</span>
                <span>@ProjectBranding.Name</span>
            </a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#ceMainNav" aria-controls="ceMainNav" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="ceMainNav">
            <nav class="navbar-nav ce-nav-center mx-auto" aria-label="Top navigation">
                <a class="nav-link" asp-area="" asp-controller="Home" asp-action="Index">Home</a>
                <a class="nav-link" asp-area="" asp-controller="Nearby" asp-action="Index">Nearby</a>
                <a class="nav-link" asp-area="" asp-controller="Menu" asp-action="Index">Menus</a>
                @if (User.Identity?.IsAuthenticated == true)
                {
                    @if (User.IsInRole(AppRole.Admin))
                    {
                        <a class="nav-link" asp-area="Admin" asp-controller="Dashboard" asp-action="Index">Admin Panel</a>
                    }
                    @if (User.IsInRole(AppRole.RestaurantOwner) || User.IsInRole(AppRole.LegacyCaterer))
                    {
                        <a class="nav-link" asp-area="Owner" asp-controller="Dashboard" asp-action="Index">My Restaurant</a>
                    }
                    @if (User.IsInRole(AppRole.Customer) || User.IsInRole(AppRole.LegacyUser))
                    {
                        <a class="nav-link" asp-area="" asp-controller="Cart" asp-action="Index">Cart</a>
                        <a class="nav-link" asp-area="" asp-controller="Orders" asp-action="Index">My Orders</a>
                    }
                }
            </nav>
            <div class="d-flex align-items-center gap-2">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <div class="dropdown">
                        <button class="ce-avatar" type="button" data-bs-toggle="dropdown" aria-expanded="false">@((User.Identity?.Name ?? "U").Substring(0, 1).ToUpperInvariant())</button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li><span class="dropdown-item-text text-muted">@User.Identity?.Name</span></li>
                            <li><hr class="dropdown-divider" /></li>
                            <li>
                                <form asp-area="" asp-controller="Account" asp-action="Logout" method="post">
                                    <button class="dropdown-item" type="submit">Logout</button>
                                </form>
                            </li>
                        </ul>
                    </div>
                }
                else
                {
                    <a class="btn btn-outline-primary" asp-area="" asp-controller="Account" asp-action="Login">Login</a>
                    <a class="btn btn-primary" asp-area="" asp-controller="Account" asp-action="Register">Register</a>
                }
            </div>
            </div>
            </div>
        </nav>
    </header>
    <main role="main" class="page-frame">
        @RenderBody()
    </main>
    <footer class="ce-footer">
        <div class="ce-logo">
            <span class="ce-logo-mark">V</span>
            <span>@ProjectBranding.FullName</span>
        </div>
        <div class="d-flex gap-3 flex-wrap">
            <a asp-area="" asp-controller="Home" asp-action="Privacy">Privacy</a>
            <a asp-area="" asp-controller="Menu" asp-action="Index">Menus</a>
            <a asp-area="" asp-controller="Account" asp-action="Register">For Restaurants</a>
        </div>
    </footer>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/ce-components.js" asp-append-version="true"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script>
        document.addEventListener('scroll', () => {
            document.querySelector('.ce-navbar')?.classList.toggle('scrolled', window.scrollY > 8);
        }, { passive: true });
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>

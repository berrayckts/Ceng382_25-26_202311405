@{
    ViewData["Title"] = "Start Call";
}
<section class="plain-section call-room">
    <p class="eyebrow">Post-Purchase Live Call</p>
    <h1>Order #@ViewBag.OrderId call room</h1>
    <div id="messages" class="call-messages"></div>
    <form id="chatForm" class="filter-row">
        <input id="messageInput" placeholder="Send a coordination note" />
        <button>Send</button>
    </form>
    <div class="video-placeholders">
        <div>Local video placeholder</div>
        <div>Remote video placeholder</div>
    </div>
</section>
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/@@microsoft/signalr@9.0.0/dist/browser/signalr.min.js"></script>
    <script>
        const room = '@ViewBag.RoomName';
        const messages = document.getElementById('messages');
        const connection = new signalR.HubConnectionBuilder().withUrl('/catering-call-hub').build();
        connection.on('RoomMessage', message => {
            const line = document.createElement('div');
            line.textContent = message;
            messages.appendChild(line);
        });
        connection.on('ReceiveSignal', payload => console.log('WebRTC extension payload', payload));
        connection.start().then(() => connection.invoke('JoinRoom', room));
        document.getElementById('chatForm').addEventListener('submit', event => {
            event.preventDefault();
            const input = document.getElementById('messageInput');
            connection.invoke('SendChat', room, input.value);
            input.value = '';
        });
    </script>
}

@model IEnumerable<Northwind.Mvc.Models.ContactInfo>

@{
    ViewData["Title"] = "Contact Infos";
}

<div class="d-flex justify-content-between align-items-center mb-3">
    <div>
        <h1>Contact Infos</h1>
        <p class="text-muted mb-0">Shipper contact information list based on the classroom schema.</p>
    </div>
    <a asp-action="Create" class="btn btn-primary">Create New</a>
</div>

<table class="table table-striped table-bordered align-middle">
    <thead>
        <tr>
            <th>ID</th>
            <th>Shipper</th>
            <th>Name</th>
            <th>Surname</th>
            <th>Email</th>
            <th>Phone</th>
            <th>City</th>
            <th>Position</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
    @foreach (var item in Model)
    {
        <tr>
            <td>@item.ContactInfoId</td>
            <td>@item.Shipper?.CompanyName</td>
            <td>@item.Name</td>
            <td>@item.Surname</td>
            <td>@item.Email</td>
            <td>@item.Phone</td>
            <td>@item.City</td>
            <td>@item.Position</td>
            <td class="text-nowrap">
                <a asp-action="Edit" asp-route-id="@item.ContactInfoId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.ContactInfoId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.ContactInfoId">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

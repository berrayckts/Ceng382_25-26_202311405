@model Northwind.Mvc.Models.ContactInfo

@{
    ViewData["Title"] = "Delete Contact Info";
}

<h1>Delete Contact Info</h1>
<p class="text-danger">Are you sure you want to delete this record?</p>

<dl class="row">
    <dt class="col-sm-3">Shipper</dt>
    <dd class="col-sm-9">@Model.Shipper?.CompanyName</dd>

    <dt class="col-sm-3">Name</dt>
    <dd class="col-sm-9">@Model.Name</dd>

    <dt class="col-sm-3">Surname</dt>
    <dd class="col-sm-9">@Model.Surname</dd>

    <dt class="col-sm-3">Email</dt>
    <dd class="col-sm-9">@Model.Email</dd>
</dl>

<form asp-action="Delete">
    <input type="hidden" asp-for="ContactInfoId" />
    <button type="submit" class="btn btn-danger">Delete</button>
    <a asp-action="Index" class="btn btn-secondary">Back to List</a>
</form>

@model MenuItemFormViewModel
@{
    ViewData["Title"] = Model.Id == 0 ? "Create Menu Item" : "Edit Menu Item";
    var action = Model.Id == 0 ? "CreateMenuItem" : "EditMenuItem";
}
<section class="plain-section">
    <div class="section-heading">
        <div>
            <p class="eyebrow">Menu Management</p>
            <h1>@ViewData["Title"]</h1>
        </div>
        <a asp-action="MenuItems" class="primary-cta">Back to menu</a>
    </div>
    <form asp-action="@action" method="post" enctype="multipart/form-data" class="form-panel wide">
        <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <input asp-for="Id" type="hidden" />
        <input asp-for="ExistingImagePath" type="hidden" />
        <label>Name <input asp-for="Name" /><span asp-validation-for="Name" class="text-danger"></span></label>
        <label>Description <textarea asp-for="Description"></textarea><span asp-validation-for="Description" class="text-danger"></span></label>
        <label>Price <input asp-for="BasePrice" type="number" step="0.01" /><span asp-validation-for="BasePrice" class="text-danger"></span></label>
        <label>Category <select asp-for="CategoryId" asp-items="@(new SelectList(Model.Categories, "Id", "Name"))"><option value="">Choose category</option></select><span asp-validation-for="CategoryId" class="text-danger"></span></label>
        <label>Availability
            <select asp-for="IsActive">
                <option value="true">Available</option>
                <option value="false">Not Available</option>
            </select>
        </label>
        <label>Image URL <input asp-for="ImageUrl" placeholder="https://example.com/menu-photo.jpg" /><span asp-validation-for="ImageUrl" class="text-danger"></span></label>
        <label>Upload image <input asp-for="Image" type="file" /></label>
        @if (!string.IsNullOrWhiteSpace(Model.ExistingImagePath))
        {
            <img class="form-preview-image" src="@Model.ExistingImagePath" alt="@Model.Name" />
        }
        <label>Removable ingredients <textarea asp-for="RemovableIngredients" placeholder="Remove onion&#10;Remove nuts"></textarea></label>
        <label>Optional extras <textarea asp-for="OptionalExtras" placeholder="Extra dessert|95&#10;Premium drinks|120"></textarea></label>
        <label>Option group title <input asp-for="OptionGroupTitle" placeholder="Service style" /></label>
        <label>Option group values <textarea asp-for="OptionGroupValues" placeholder="Buffet setup|0&#10;Plated service|180"></textarea></label>
        <button class="primary-cta" type="submit">Save menu item</button>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

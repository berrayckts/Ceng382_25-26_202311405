@using Week3
@{
    var students = GradeCalculator.BuildSampleStudents();
}
<!doctype html>
<html lang="tr">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <title>Studio Notes - Student Grade Table</title>
  <link rel="stylesheet" href="style.css" />
</head>
<body>
  <header class="topbar">
    <div class="brand">Studio Notes</div>

    <nav class="topnav" aria-label="Top Menu">
      <a class="topnav__link is-active" href="#">Home</a>
      <a class="topnav__link" href="#">Privacy</a>
    </nav>

    <div class="auth-links">
      <a class="auth-link" href="#">Register</a>
      <a class="auth-link" href="#">Login</a>
    </div>
  </header>

  <main class="page">
    <section class="grade-card">
      <div class="grade-card__head">
        <div class="grade-card__intro">
          <span class="grade-card__eyebrow">Week 3 Dashboard</span>
          <h1 class="grade-card__title">Student Grade Table</h1>
          <p class="grade-card__subtitle">Daha sıcak, sade ve kişisel bir görünümle not tablosunu tek ekranda okunur tutan özel bir ders paneli.</p>
        </div>
        <button id="calculateBtn" class="calc-btn" type="button">Calculate Letter Grades</button>
      </div>

      <div class="table-wrap">
        <table class="grade-table" aria-label="Student Grades">
          <thead>
            <tr>
              <th>#</th>
              <th>Student</th>
              <th>Midterm</th>
              <th>Final</th>
              <th>Letter Grade</th>
            </tr>
          </thead>
          <tbody>
            @for (var i = 0; i < students.Count; i++)
            {
              <tr>
                <td>@(i + 1)</td>
                <td>@students[i].Name</td>
                <td class="midterm">@students[i].Midterm</td>
                <td class="final">@students[i].Final</td>
                <td class="letter-grade">-</td>
              </tr>
            }
          </tbody>
        </table>
      </div>

      <p class="note">Calculation: 40% Midterm + 60% Final</p>
    </section>
  </main>
  <script>
    function getLetterGrade(average) {
      if (average >= 90) return "AA";
      if (average >= 85) return "BA";
      if (average >= 80) return "BB";
      if (average >= 75) return "CB";
      if (average >= 70) return "CC";
      if (average >= 60) return "DC";
      if (average >= 50) return "DD";
      return "FF";
    }

    document.getElementById("calculateBtn").addEventListener("click", function () {
      const rows = document.querySelectorAll(".grade-table tbody tr");

      rows.forEach(function (row) {
        const midterm = Number(row.querySelector(".midterm").textContent);
        const finalExam = Number(row.querySelector(".final").textContent);
        const average = (midterm * 0.4) + (finalExam * 0.6);
        row.querySelector(".letter-grade").textContent = getLetterGrade(average);
      });
    });
  </script>
</body>
</html>
